@page "/transactions"
@rendermode InteractiveServer
@attribute [Authorize]
@using InvestPortfolio.Models
@using InvestPortfolio.Services
@inject IPortfolioService PortfolioService
@inject IJSRuntime JS

<PageTitle>Transactions - InvestPortfolio</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Historique des Transactions</h2>
        <p class="text-muted mb-0">Suivi complet de vos opérations d'achat et de vente</p>
    </div>
    <a href="/new-transaction" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Nouvelle Transaction
    </a>
</div>

<!-- Filtres -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text"
                           @bind="SearchText"
                           @bind:event="oninput"
                           class="form-control"
                           placeholder="Rechercher par nom d'actif..." />
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="SelectedTransactionType" @bind:after="ExecuteSearch">
                    <option value="">Tous les types</option>
                    <option value="Achat">Achats</option>
                    <option value="Vente">Ventes</option>
                </select>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center h-100">
                    <span class="badge bg-primary-subtle text-primary fs-6 px-3 py-2">
                        @FilteredTransactions.Count transaction(s)
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tableau des transactions -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <TransactionTable Transactions="FilteredTransactions" OnDeleteClicked="DeleteTransaction" />
    </div>
</div>

@code {
    private List<Transaction> FilteredTransactions = new();
    private string _searchText = "";
    private string SelectedTransactionType = "";

    private string SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            _ = ExecuteSearch();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ExecuteSearch();
    }

    private async Task ExecuteSearch()
    {
        FilteredTransactions = await PortfolioService.SearchTransactionsAsync(_searchText, SelectedTransactionType);
    }

    private async Task DeleteTransaction(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Supprimer cette transaction ? Le budget sera ajusté.");
        if (confirmed)
        {
            await PortfolioService.DeleteTransactionAsync(id);
            await ExecuteSearch();
        }
    }
}
